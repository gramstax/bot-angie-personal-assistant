# Angie — Gramstax bot (salin ke .env, isi dengan token ASLI milikmu — jangan commit .env)
# Telegram Bot Token (dari @BotFather)
BOT_TOKEN=

# Bot Deployment Mode: polling | webhook | serverless
BOT_DEPLOY=polling
# BOT_WEBHOOK_URL=
# BOT_WEBHOOK_SECRET=

# Cache session
CACHE_SESSION_STORE=memory
CACHE_SESSION_TTL=14400000
CACHE_SESSION_NAMESPACE=s

# LMDB database path
DB_PATH="./data"

# OpenAI — jawaban AI (gpt-4o-mini) + transkripsi voice (whisper-1).
# Kosong = bot tetap jalan dalam mode mock (jawaban sederhana dari data LMDB).
OPENAI_API_KEY=

# Google OAuth2 access token — Gmail + Google Calendar.
# Kosong = tool email/kalender menjawab "belum terhubung" (tidak ada data palsu).
# Dapatkan dari Google Cloud Console (OAuth2, scope gmail.readonly + calendar.readonly),
# lalu tukar refresh token menjadi access token bila perlu.
GOOGLE_ACCESS_TOKEN=

# AllowList: ID Telegram (angka) yang diizinkan, dipisah koma. Kosong = semua diizinkan (mode dev).
ANGIE_ALLOWED_IDS=

# Mode mock AI (1 = paksa jawaban mock walau OPENAI_API_KEY terisi; dipakai e2e).
ANGIE_MOCK_AI=

# Angie — Gramstax bot (copy to .env and fill in with your REAL tokens — never commit .env)
# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# Bot Deployment Mode: polling | webhook | serverless
BOT_DEPLOY=polling
# BOT_WEBHOOK_URL=
# BOT_WEBHOOK_SECRET=

# Cache session
CACHE_SESSION_STORE=memory
CACHE_SESSION_TTL=14400000
CACHE_SESSION_NAMESPACE=s

# LMDB database path
DB_PATH="./data"

# OpenAI — AI answers (gpt-4o-mini) + voice transcription (whisper-1).
# Empty = the bot still runs in mock mode (simple answers from LMDB data).
OPENAI_API_KEY=

# Google OAuth2 access token — Gmail + Google Calendar.
# Empty = the email/calendar tools answer "not connected" (no fake data).
# Get it from Google Cloud Console (OAuth2, scopes gmail.readonly + calendar.readonly),
# then exchange a refresh token for an access token when needed.
GOOGLE_ACCESS_TOKEN=

# AllowList: Telegram IDs allowed to use the bot, comma-separated. Empty = everyone allowed (dev mode).
ANGIE_ALLOWED_IDS=

# Mock AI mode (1 = force mock answers even when OPENAI_API_KEY is set; used by e2e).
ANGIE_MOCK_AI=
